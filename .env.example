# Database — Railway injects this automatically when you connect a Postgres plugin
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL="postgresql://postgres:password@localhost:5432/agentbay"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="your-secret-key-here-change-in-production"

# Groq (LLaMA 3) — https://console.groq.com
GROQ_API_KEY="gsk_..."

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# App — set to your Railway domain in production
NEXT_PUBLIC_APP_URL="https://your-app.railway.app"
